# Settings for the Dubly container. Copy this file to deploy/docker/dubly.env (gitignored, never baked into the image) and fill it in.
# Every variable in .env.example and docs/DEPLOYMENT.md works here. Changes apply on the next `docker compose up -d`.
#
# Leave these OUT, the container handles them:
#   MONGODB_URI, MONGODB_TEST_URI  the container runs its own MongoDB and logins. Set MONGODB_URI only to use another database instead.
#   HOST, PORT                     the app listens on 8787 inside; choose the host side with DUBLY_BIND / DUBLY_PORT (compose.yaml).
#   DUBLY_TMP_DIR, DUBLY_CACHE_DIR, CREDENTIALS_DIR, DUBLY_ENV_FILE

# --- Address -------------------------------------------------------------------------------------------------------------------------
# Where people open Dubly. Links in emails point here, and https:// makes the session cookie Secure.
WEB_ORIGIN=http://localhost:8787
# Behind a reverse proxy, tunnel or load balancer: the number of hops in front, so per-IP limits see the visitor. Unset when the app
# is reached directly, or anyone could fake their address.
# TRUST_PROXY=1
# Behind the Cloudflare Worker front door: the secret it sends, so the visitor address it forwards is trusted.
# EDGE_SHARED_SECRET=
# The Worker's address. Set, the container opens its own Cloudflare quick tunnel and points the Worker at it (deploy/docker/front-door.mjs),
# so no domain, port or Cloudflare login is needed. Needs EDGE_SHARED_SECRET, TRUST_PROXY=1, and WEB_ORIGIN set to this same address.
# FRONT_DOOR_URL=https://dubly.<account>.workers.dev

# --- Accounts --------------------------------------------------------------------------------------------------------------------------
# false: accounts only by invitation, or `docker compose exec -u node dubly node --import tsx server/scripts/create_user.ts <email>`.
ALLOW_SIGNUP=false
# NEW_WORKSPACE_PLAN=free

# --- AI (Google) -----------------------------------------------------------------------------------------------------------------------
# The service account key is mounted from DUBLY_CREDENTIALS_DIR (compose.yaml) as gcp-service-account.json.
# On Google Cloud with a VM/Cloud Run service account instead: CREDENTIALS_MODE=adc and no key file.
VERTEX_PROJECT_ID=
# VERTEX_GEMINI_LOCATION=global
# CREDENTIALS_MODE=adc
# TTS_ENGINE=cloud
# GEMINI_API_KEY=

# --- Email (invitations, sign-in links, password resets) -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=no-reply@scatterpie.io
# SMTP_PASS=
# MAIL_FROM=Dubly <no-reply@scatterpie.io>

# --- Built-in MongoDB ----------------------------------------------------------------------------------------------------------------
# WiredTiger cache in GB. About a quarter of the memory Docker has; the rest is for ffmpeg, ONNX and Node during dubs.
# MONGO_CACHE_GB=1
# true only to reach the database from Compass through the commented port in compose.yaml (published on 127.0.0.1 only).
# MONGO_LISTEN_ALL=false

# --- Daily backup into DUBLY_BACKUP_DIR ------------------------------------------------------------------------------------------------
# The time of day is in TZ. BACKUP_KEEP is how many backups to keep; each holds every video, so mind the space.
# BACKUP_TIME=03:00
# BACKUP_KEEP=3
# TZ=Asia/Kolkata
