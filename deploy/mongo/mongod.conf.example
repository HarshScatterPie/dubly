# MongoDB for Dubly: a single-node replica set (transactions), reachable from this machine only, with access control on.
# Linux: /etc/mongod.conf. Windows: %USERPROFILE%\dubly-mongo\mongod.cfg with Windows paths. See docs/MONGODB.md.
storage:
  dbPath: /var/lib/mongodb
  wiredTiger:
    engineConfig:
      # About a quarter of the machine's memory; the rest is for ffmpeg, ONNX and Node during dubs.
      cacheSizeGB: 1
systemLog:
  destination: file
  path: /var/log/mongodb/mongod.log
  logAppend: true
net:
  # Never 0.0.0.0: the app runs on the same machine. Use an SSH tunnel for Compass from elsewhere.
  bindIp: 127.0.0.1
  port: 27017
replication:
  replSetName: rs0
security:
  authorization: enabled
  # Members of a replica set authenticate to each other with this key (needed even with one member once access control is on).
  keyFile: /etc/mongod.key
processManagement:
  timeZoneInfo: /usr/share/zoneinfo
