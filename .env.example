# --- Frontend (Vite) — goes in .env, safe to be public (Firebase client config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend (Express) — goes in server/.env (or the file named by DUBLY_ENV_FILE), NEVER commit real values ---
# PORT=8787
# WEB_ORIGIN=http://localhost:3000
# VERTEX_PROJECT_ID=
# VERTEX_GEMINI_LOCATION=global
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
# TTS_ENGINE=gemini                  # or chirp: plain Chirp3-HD voices without emotion direction
# GEMINI_TTS_MODEL=gemini-2.5-flash-tts
# GEMINI_TTS_PREMIUM_MODEL=gemini-3.1-flash-tts-preview   # only for users who turn on Premium voices
# GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite               # AI review, only for users who turn it on
# FIREBASE_STORAGE_BUCKET=
#
# Credentials (see docs/SECURITY.md):
#   Local development: key files in server/credentials/ (gitignored), or in CREDENTIALS_DIR:
#     gcp-service-account.json       — Vertex AI + Cloud TTS
#     firebase-service-account.json  — Firebase Admin
#   Production: CREDENTIALS_MODE=adc uses the VM/Cloud Run service account; no key files at all.
# CREDENTIALS_MODE=adc
# FIREBASE_PROJECT_ID=           # required with CREDENTIALS_MODE=adc
# CREDENTIALS_DIR=               # keep keys outside synced folders (OneDrive/Dropbox)
# DUBLY_ENV_FILE=                # load this env file instead of server/.env
#
# Operations (defaults shown; see docs/DEPLOYMENT.md):
# TRUST_PROXY=1                  # behind one reverse proxy / tunnel, so per-IP limits see the client
# LOG_FORMAT=json                # json by default when NODE_ENV=production
# SHUTDOWN_GRACE_MS=25000
# MAX_VIDEO_MINUTES=60
# MAX_DUBS_PER_WORKSPACE=2
# MAX_ACTIVE_DUBS=4
# MAX_HEAVY_REQUESTS=3
# HEAVY_WAIT_SECONDS=600
# TRANSCRIBE_TIMEOUT_MINUTES=45
# STORAGE_LIMIT_MB=2048
# ENFORCE_STORAGE_LIMIT=false
# FFMPEG_PATH=                   # set in the Docker image to the OS ffmpeg
# FFPROBE_PATH=
# FFMPEG_QUICK_TIMEOUT_MINUTES=5
# FFMPEG_RENDER_TIMEOUT_MINUTES=120
# RATE_TRANSCRIBE_PER_HOUR=20    # every RATE_* limit is listed in docs/DEPLOYMENT.md

# Optional: voice cloning on a Hugging Face ZeroGPU Space. The token is what makes calls
# draw on your own daily GPU quota rather than the stricter anonymous pool.
HF_SPACE_URL=
HF_TOKEN=
