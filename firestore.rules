rules_version = '2';

// Dubly's backend uses the Firebase Admin SDK, which always bypasses these rules — all
// current reads/writes go through the trusted Express server, never directly from the
// browser. These rules exist as defense-in-depth for if/when this app is embedded into
// ScatterStudio and gains direct client-side Firestore access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
