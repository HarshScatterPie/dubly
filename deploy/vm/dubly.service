# Installed to /etc/systemd/system by deploy/vm/install.sh (placeholders filled in there).
[Unit]
Description=Dubly (API + built frontend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/dubly
Environment=NODE_ENV=production
Environment=PATH=/opt/node-24/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Operational settings (proxy hops, capacity limits); secrets stay in server/.env and server/credentials.
EnvironmentFile=-__HOME__/dubly-shared/runtime.env
ExecStart=/opt/node-24/bin/node node_modules/tsx/dist/cli.mjs server/index.ts
Restart=always
RestartSec=5
# SIGTERM goes to Node only, so it can drain; ffmpeg children are stopped with it, not before it.
KillMode=mixed
TimeoutStopSec=40
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
