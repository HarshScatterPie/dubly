# --- Frontend (Vite) — goes in .env, safe to be public (Firebase client config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend (Express) — goes in server/.env, NEVER commit real values ---
# PORT=8787
# WEB_ORIGIN=http://localhost:3000
# VERTEX_PROJECT_ID=
# VERTEX_GEMINI_LOCATION=global
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
# FIREBASE_STORAGE_BUCKET=
#
# Also required in server/credentials/ (gitignored):
#   gcp-service-account.json       — Vertex AI service account
#   firebase-service-account.json  — Firebase Admin service account

# Optional: voice cloning on a Hugging Face ZeroGPU Space. The token is what makes calls
# draw on your own daily GPU quota rather than the stricter anonymous pool.
HF_SPACE_URL=
HF_TOKEN=
