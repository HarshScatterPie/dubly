# The frontend needs no configuration of its own: it only talks to the Dubly server.

# --- Backend (Express) — goes in server/.env (or the file named by DUBLY_ENV_FILE), NEVER commit real values ---
# MongoDB holds everything (accounts, sessions, records, files). A replica set is required; see docs/MONGODB.md.
# deploy/mongo/setup-users.mjs writes these three lines (with real passwords) to its credentials file.
# MONGODB_URI is the dubly_app line from that file: mongodb://dubly_app:PASSWORD@127.0.0.1:27017/dubly?authSource=admin&directConnection=true  # trufflehog:ignore
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=dubly
# For npm test only: a database whose name ends in _test, emptied between tests.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/dubly_test?directConnection=true
# PORT=8787
# WEB_ORIGIN=http://localhost:3000   # where people open Dubly; links in emails point here
# ALLOW_SIGNUP=true                  # false: accounts only from invitations and server/scripts/create_user.ts
# COOKIE_SECURE=                     # auto: Secure on HTTPS requests and whenever WEB_ORIGIN is https; true always; false never
# MEDIA_URL_SECRET=                  # optional; otherwise a random key is kept in the database (system.mediaUrlKey)
# VERTEX_PROJECT_ID=
# VERTEX_GEMINI_LOCATION=global
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
# TTS_ENGINE=cloud                   # Gemini 2.5 Flash + Chirp 3 HD on Cloud TTS, no Gemini API key; chirp: Chirp 3 HD only; gemini: plan-tiered Gemini 3.8 voices (needs a paid GEMINI_API_KEY)
# GEMINI_TTS_CLOUD_MODEL=gemini-2.5-flash-tts              # Gemini 2.5 Flash voices (TTS_ENGINE=cloud)
# GEMINI_TTS_LITE_MODEL=gemini-3.8-flash-lite-tts         # Gemini 3.8 Flash-Lite voices (every plan)
# GEMINI_TTS_FLASH_MODEL=gemini-3.8-flash-tts             # Gemini 3.8 Flash voices (Enterprise)
# GEMINI_API_KEY=                    # needed for Gemini 3.8 voices (Vertex does not serve 3.8 TTS yet); use a key on a billed project
# GEMINI_TTS_PREMIUM_MODEL=gemini-3.1-flash-tts-preview   # only for users who turn on Premium voices
# GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite               # AI review, only for users who turn it on
#
# Credentials (see docs/SECURITY.md):
#   Local development: key files in server/credentials/ (gitignored), or in CREDENTIALS_DIR:
#     gcp-service-account.json       — Vertex AI + Cloud TTS (the only Google credential left)
#   Production: CREDENTIALS_MODE=adc uses the VM/Cloud Run service account; no key files at all.
# CREDENTIALS_MODE=adc
# CREDENTIALS_DIR=               # keep keys outside synced folders (OneDrive/Dropbox)
# DUBLY_ENV_FILE=                # load this env file instead of server/.env
#
# Operations (defaults shown; see docs/DEPLOYMENT.md):
# TRUST_PROXY=1                  # behind one reverse proxy / tunnel, so per-IP limits see the client
# LOG_FORMAT=json                # json by default when NODE_ENV=production
# SHUTDOWN_GRACE_MS=25000
# MAX_VIDEO_MINUTES=60
# MAX_DUBS_PER_WORKSPACE=2
# WEB_CONCURRENCY=auto          # server processes on this machine; auto = half the cores (production default)
# INSTANCE_COUNT=1               # machines serving this database, behind a load balancer
# DUBLY_TMP_DIR=                 # scratch files; keep off synced folders (OneDrive/Dropbox)
# DUBLY_CACHE_DIR=               # the voice cache
# UPLOAD_CHUNK_MB=32
# STT_CHUNK_SECONDS=28           # audio per speech-model call; see the note in server/lib/vertexClient.ts before raising it
# MAX_ACTIVE_DUBS=               # this machine's total; default half the cores, at least 2
# MAX_HEAVY_REQUESTS=            # this machine's total; default 3/8 of the cores, at least 2
# HEAVY_WAIT_SECONDS=600
# TRANSCRIBE_TIMEOUT_MINUTES=45
# STORAGE_LIMIT_MB=2048
# ENFORCE_STORAGE_LIMIT=true
# FFMPEG_PATH=                   # set in the Docker image to the OS ffmpeg
# FFPROBE_PATH=
# FFMPEG_QUICK_TIMEOUT_MINUTES=5
# FFMPEG_RENDER_TIMEOUT_MINUTES=120
# RATE_TRANSCRIBE_PER_HOUR=20    # every RATE_* limit is listed in docs/DEPLOYMENT.md

# Emails: invitations, sign-up confirmation and password reset (any SMTP account). Empty = invitations by link, and outside
# production the confirmation/reset links are printed to the server log instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=no-reply@scatterpie.io
# SMTP_PASS=
# MAIL_FROM=Dubly <no-reply@scatterpie.io>
